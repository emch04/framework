{
  "name": "@astratra/pdf",
  "version": "0.2.0",
  "description": "Layout primitives for PDFKit: text that never overruns its box, tables that paginate without splitting a row, and credit-card sheets with vector QR codes and brand logos.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "pdf",
    "pdfkit",
    "layout"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pdfkit": ">=0.15"
  },
  "peerDependenciesMeta": {
    "pdfkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "30.4.2",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4"
  }
}
