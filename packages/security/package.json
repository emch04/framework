  },
  "peerDependencies": {
    "rate-limit-redis": ">=4",
    "redis": ">=4"
  },
  "peerDependenciesMeta": {
    "rate-limit-redis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "30.4.2",
    "rate-limit-redis": "^6.0.1",
    "redis": "^4.7.0"
  }
