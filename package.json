{
  "name": "astratra",
  "private": true,
  "version": "0.0.0",
  "description": "Astratra npm workspace monorepo.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/dashboard-ui"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:packages": "node scripts/verify-package-installation.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.18.0",
    "typescript": "^5.9.2"
  }
}
