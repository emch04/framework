{
  "name": "@astratra/saas-kit-ui",
  "version": "1.3.0",
  "description": "Reusable React dashboard shell for Astratra SaaS applications, plus a thumbs up/down feedback bar for AI answers.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/index.jsx",
  "module": "src/index.jsx",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.jsx"
    },
    "./api": {
      "types": "./src/lib/api.d.ts",
      "default": "./src/lib/api.js"
    },
    "./styles.css": "./src/styles/global.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test __tests__/*.test.js"
  },
  "keywords": [
    "astratra",
    "react",
    "dashboard",
    "saas"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@types/react": "^19.2.18"
  },
  "types": "src/index.d.ts",
  "typesVersions": {
    "*": {
      "api": [
        "src/lib/api.d.ts"
      ]
    }
  }
}
