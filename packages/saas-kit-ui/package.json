{
  "name": "@astratra/saas-kit-ui",
  "version": "1.0.1",
  "description": "Reusable React dashboard shell for Astratra SaaS applications.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/index.jsx",
  "module": "src/index.jsx",
  "exports": {
    ".": "./src/index.jsx",
    "./api": "./src/lib/api.js",
    "./styles.css": "./src/styles/global.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test __tests__/*.test.js"
  },
  "keywords": [
    "astratra",
    "react",
    "dashboard",
    "saas"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
