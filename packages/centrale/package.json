{
  "name": "@astratra/centrale",
  "version": "1.0.2",
  "description": "Paquet de collecte pour un tableau de bord de surveillance auto-hébergé : erreurs, vues, usages, sessions et appels d'IA, masqués à la source. Sans aucune dépendance.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./navigateur": {
      "types": "./dist/navigateur.d.ts",
      "default": "./dist/navigateur.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "default": "./dist/expo.js"
    },
    "./ia": {
      "types": "./dist/ia.d.ts",
      "default": "./dist/ia.js"
    },
    "./envoi": {
      "types": "./dist/envoi.d.ts",
      "default": "./dist/envoi.js"
    },
    "./masquage": {
      "types": "./dist/masquage.d.ts",
      "default": "./dist/masquage.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "astratra",
    "centrale",
    "erreurs",
    "monitoring",
    "collecte"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "express": "^4.18.3"
  }
}
