{
  "name": "@astratra/collab",
  "version": "1.0.0",
  "description": "Real-time collaborative editing: Hocuspocus server wired to your auth (read/write per document), injectable persistence with Yjs snapshots, named versions and restore, size limits, a headless Tiptap editor factory, and Yjs to JSON/Markdown/HTML conversion for search and export.",
  "engines": {
    "node": ">=20.19"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest --runInBand"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^marked$": "<rootDir>/../../node_modules/marked/lib/marked.umd.js"
    }
  },
  "keywords": [
    "astratra",
    "collaboration",
    "yjs",
    "crdt",
    "hocuspocus",
    "tiptap",
    "wiki",
    "markdown"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/static-renderer": "^3.31.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "jest": "30.4.2",
    "jsdom": "^30.0.1",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.17.0",
    "pg": "^8.13.1",
    "pg-mem": "^3.0.5",
    "ws": "^8.22.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client-entry.d.ts",
      "default": "./src/client-entry.js"
    },
    "./package.json": "./package.json"
  }
}
