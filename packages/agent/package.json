{
  "name": "@astratra/agent",
  "version": "1.1.0",
  "description": "Budgeted, verifiable and durable task execution with injected models and tools, plus user feedback (thumbs up/down) on runs that the agent learns from.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astratra/ai": "^1.8.0"
  },
  "devDependencies": {
    "express": "^4.18.3",
    "pg": "^8.13.1",
    "supertest": "^7.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./feedback": {
      "types": "./src/feedback/index.d.ts",
      "default": "./src/feedback/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
