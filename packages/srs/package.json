{
  "name": "@astratra/srs",
  "version": "1.0.0",
  "description": "Spaced repetition on top of FSRS: cards, grading (Again/Hard/Good/Easy), next due date, FSRS parameters, daily queue and statistics, with an injectable store.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
