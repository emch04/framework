{
  "name": "@astratra/gouvernance",
  "version": "1.3.0",
  "description": "Governed data actions for AI agents: the agent proposes, an exact preview is computed, a human validates (signed, bound to the exact proposal, with an expiry), the data is re-checked at commit time and the change runs all or nothing, with a full audit trail. Builds on @astratra/conscience.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "astratra",
    "ai",
    "agent",
    "governance",
    "approval",
    "audit",
    "webauthn",
    "postgres",
    "mongodb"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astratra/conscience": "^1.4.0"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "mongodb": "^6.0.0",
    "mongodb-memory-server": "^10.2.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.d.ts",
      "default": "./src/postgres/index.js"
    },
    "./mongo": {
      "types": "./src/mongo/index.d.ts",
      "default": "./src/mongo/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "mongodb": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  }
}
