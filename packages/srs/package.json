    "src"
  ],
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "spaced-repetition",
    "fsrs",
    "flashcards"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "jest": "30.4.2"
  }
}
