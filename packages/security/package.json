{
  "name": "@astratra/security",
  "version": "1.2.0",
  "description": "Generic authentication and security middleware for Astratra workspaces.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "security",
    "auth"
  ],
  "license": "MIT",
  "publishConfig": {
