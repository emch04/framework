{
  "name": "@astratra/ai",
  "version": "1.8.0",
  "description": "Generic AI provider routing, tool registry, and agent loop utilities for Astratra, plus agent guards (@astratra/ai/guards): outbound masking, prompt-injection handling for untrusted tool results, reply checks.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src",
    "deploy",
    "guards"
  ],
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "ai",
    "agents",
    "llama.cpp",
    "cpu-inference",
    "guardrails",
    "prompt-injection"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astratra/core": "^1.0.0"
  },
  "peerDependencies": {
    "redis": ">=4",
    "@astratra/rag": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    },
    "@astratra/rag": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astratra/resilience": "^1.0.0",
    "jest": "30.4.2",
    "redis": "^4.7.0",
    "@astratra/rag": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./guards": {
      "types": "./src/guards/index.d.ts",
      "default": "./src/guards/index.js"
    },
    "./guards/testing": {
      "types": "./src/guards/testing/index.d.ts",
      "default": "./src/guards/testing/index.js"
    },
    "./package.json": "./package.json"
  }
}
