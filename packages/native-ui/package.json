{
  "name": "@astratra/native-ui",
  "version": "0.1.0",
  "description": "Mobile UI kit for React Native / Expo: Apple's Liquid Glass on iOS and a calibrated visible surface on Android, glass buttons, pale cards, bars that fold on scroll, an Instagram-style tab bar, a collapsible header, and a Markdown renderer for AI answers. Pure rules exported separately and tested in plain Node.",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./logic": {
      "types": "./src/logic/index.d.ts",
      "default": "./src/logic/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "react-native",
    "expo",
    "liquid-glass",
    "ui",
    "tab-bar",
    "markdown"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@astratra/native": "^0.2.0"
  },
  "peerDependencies": {
    "expo-blur": ">=14",
    "expo-glass-effect": ">=0.1",
    "expo-linear-gradient": ">=14",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-reanimated": ">=3.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jest": "30.4.2",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.8"
  }
}
