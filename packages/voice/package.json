{
  "name": "@astratra/voice",
  "version": "1.1.0",
  "description": "Server-side text-to-speech finishing and caching: deterministic voice-version keys, Piper (command line and HTTP) and ffmpeg builders, cancellation by AbortSignal, injected process and file adapters, and memory caches (bounded LRU included).",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "commonjs",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "keywords": [
    "astratra",
    "voice",
    "text-to-speech",
    "piper",
    "ffmpeg",
    "cache",
    "sherpa-onnx",
    "faster-whisper",
    "speech-to-text"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "sherpa-onnx-node": ">=1.13.8"
  },
  "peerDependenciesMeta": {
    "sherpa-onnx-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "30.4.2"
  }
}
